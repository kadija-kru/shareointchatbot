# ── Data Connector ──────────────────────────────────────────────────────────
# Use 'mock' for the demo; future values: 'sharepoint'
DATA_CONNECTOR=mock

# Path to mock documents (inside container; leave as-is unless you mount a custom volume)
DATA_DIR=/app/data/mock_docs

# ── Ollama (LLM service) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ── RAG Settings ─────────────────────────────────────────────────────────────
# Number of top documents to retrieve per query
TOP_K=4

# When true, the LLM is instructed to answer ONLY from retrieved context.
# Set to 'false' to allow the model to use its general knowledge as well.
STRICT_GROUNDED=true

# ── Index Persistence ────────────────────────────────────────────────────────
# Directory inside the container where the FAISS index is persisted.
# Mapped to a named Docker volume in docker-compose.yml.
INDEX_DIR=/app/.index

# ── Streamlit ────────────────────────────────────────────────────────────────
# Host port exposed by the app service (default: 8501)
APP_PORT=8501
